{
  "manifest_version": 3,
  "name": "Family Cabin Finder for Royal Caribbean",
  "short_name": "Cabin Finder",
  "version": "1.0.1",
  "description": "Search Royal Caribbean sailings for rooms that sleep your whole family and for open connecting rooms.",
  "permissions": ["storage", "unlimitedStorage", "scripting", "tabs"],
  "host_permissions": ["https://www.royalcaribbean.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Family Cabin Finder" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
